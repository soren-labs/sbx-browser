# sbx-browser — example environment. Copy to .env and fill in.
# NEVER commit real values. Anything marked <secret> belongs in a Modal
# Secret or your local shell — not in git, issues, logs, or PRs.

# ---------------------------------------------------------------- client ---
# What `sbx deploy` / `sbx doctor` prints; used by examples/sbx_client.py.
SBX_BASE_URL=https://<your-sbx-control-url>
SBX_API_KEY=sbx_<your-api-key>            # <secret> — control plane stores sha256 only

# ------------------------------------------------------- deploy / control ---
# Modal auth uses `modal token new` (~/.modal.toml); MODAL_PROFILE picks the
# workspace profile for make targets.
MODAL_PROFILE=default
# Custom control-plane app name (default: sbx-control).
#SBX_MODAL_APP_NAME=sbx-control

# Bootstrap API key for first deploy — seeds one admin key + default accounts
# on control-plane boot. Deliver via `modal secret create sbx-v1-bootstrap`.
#SBX_V1_BOOTSTRAP_KEY=sbx_<long-random>   # <secret>

# Internal dashboard Basic auth (/api/*, web/). Deliver via secret sbx-basic-auth.
#SBX_BASIC_USER=<user>                    # <secret>
#SBX_BASIC_PASS=<long-random>             # <secret>

# Tuning (defaults shown).
# SBX_MAX_CONCURRENT caps LIVE agents/sandboxes — the per-key cap (default 2)
# and the scheduler's global cap (default 8) both read it. An idle agent
# waiting for a follow-up still holds a slot; close it (DELETE
# /v1/agents/{id}) or it frees at SBX_IDLE_TIMEOUT_S / reaper sweep.
# Also settable as deploy.max_concurrent in $SBX_CONFIG.
#SBX_MAX_CONCURRENT=2
# Lifecycle chain — one resolved value feeds the runner bound, the
# sandbox's native timers, and the reaper; also settable as
# deploy.<name> in $SBX_CONFIG. run staleness = SBX_TURN_MAX_SECONDS +
# SBX_RUN_GRACE_S.
# SBX_IDLE_TIMEOUT_S is the post-session idle retention only — how long an
# idle agent's sandbox stays warm for a follow-up before the reaper
# reclaims it. The sandbox's own native idle bound is a separate knob,
# SBX_SANDBOX_IDLE_TIMEOUT_S, floored at SBX_TURN_MAX_SECONDS +
# SBX_RUN_GRACE_S so a running turn is never reclaimed by it.
#SBX_IDLE_TIMEOUT_S=300
#SBX_SANDBOX_IDLE_TIMEOUT_S=1800
#SBX_TURN_MAX_SECONDS=900
#SBX_SANDBOX_TIMEOUT_S=14400
#SBX_CREATE_GRACE_S=300
#SBX_RUN_GRACE_S=300

# Provider account seeding (env on the Modal app). Per provider:
#   SBX_<PROVIDER>_SLOTS / _MODELS / _ACCOUNT_ID / _SECRET_NAME
#   SBX_<PROVIDER>_ACCOUNTS = JSON list [{"id","label","secret_name","slots","models"}]
#SBX_DEVIN_BURST_SLOTS=8
#SBX_ANTIGRAVITY_ACCOUNTS=[{"id":"agy-1","slots":4}]

# ---------------------------------------------------------- local dev/test ---
# Backend: local (default, no Modal) or modal.
#SBX_BACKEND=local
# Optional GitHub bridge (SOR-117): private-repo clone/push + PR creation
# inside sandboxes. BOTH vars required — the token alone injects nothing.
# Least privilege: fine-grained PAT scoped to the agent repos, Contents +
# (optionally) Pull requests read/write, shortest practical lifetime.
#GH_TOKEN=ghp_...                  # <secret> — or GITHUB_TOKEN
#SBX_GITHUB_EPHEMERAL=1            # explicit opt-in gate
# For a deployed (remote) control plane, name a Modal Secret holding the
# token instead of exporting it on the deploy host — mounted only when the
# gate is armed:
#SBX_GITHUB_SECRET_NAME=sbx-github  # modal secret create sbx-github GH_TOKEN=...
# Both persist as [github] ephemeral/secret_name in $SBX_CONFIG — set them
# once via `sbx init --github --github-secret sbx-github`. Only the Secret
# *name* is ever persisted; the token value never leaves the Modal Secret.
#SBX_WORK=/work
# Runner / provider binary overrides (tests point these at tests/fakes/*).
#SBX_RUNNER_CMD="python -m runtime.runner"
#CODEX_BIN=codex
#AGY_BIN=agy
#GROK_BIN=grok
#DEVIN_BIN=devin
#OPENCODE_BIN=opencode
# Image-build host CLI locations for agy / grok (never committed).
#SBX_AGY_BIN=~/.local/bin/agy
#SBX_GROK_BIN=~/.local/bin/grok
#SBX_RUN_STORE_DIR=<dir>
# Legacy codex-only credential path (prefer account blobs / sbx-codex-auth).
#CODEX_AUTH_JSON=<secret>
# Fake-provider scenario for tests:
# success|resume|nonzero|hang|badjson|slow|auth_invalid
#FAKE_CODEX_SCENARIO=success
#FAKE_AGY_SCENARIO=success
#FAKE_GROK_SCENARIO=success
#FAKE_OPENCODE_SCENARIO=success
#FAKE_DEVIN_SCENARIO=success

# -------------------------------------------------- sandbox-internal (info) --
# Set BY THE CONTROL PLANE inside sandboxes — do not set these yourself:
#   SBX_ACCOUNT_CREDENTIAL  credential blob {"provider","files"} <secret>
#   SBX_ACCOUNT_ID          current account id
#   HOME=$SBX_WORK/home, CODEX_HOME=$HOME/.codex

# --------------------------------------------------- browser user auth --
# Secure cookies are the default, including local runs. For HTTP dev ONLY:
#SBX_AUTH_COOKIE_SECURE=false
#SBX_AUTH_SESSION_TTL_S=604800
# Exact production origin (include scheme, no path):
#SBX_AUTH_ORIGIN=https://sbx.example
# PostgreSQL is mandatory on Modal / multiple hosts. Store its URL in the
# named Modal Secret below; never bake the DSN into a deployment env overlay.
#SBX_AUTH_SECRET_NAME=sbx-user-auth
#SBX_AUTH_DATABASE_URL=REDACTED
# Single-host local SQLite override (otherwise XDG_STATE_HOME/sbx/auth.sqlite3):
#SBX_AUTH_SQLITE_PATH=/tmp/sbx-dev-auth.sqlite3
